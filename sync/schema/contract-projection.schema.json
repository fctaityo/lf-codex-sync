{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fctaityo/lf-codex-sync/main/sync/schema/contract-projection.schema.json",
  "title": "LF CODEX Linkage Mandatory Contract Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection_schema_version", "contract_id", "contract_name", "source_internal_commit_sha",
    "applies_to", "source_contracts", "release_binding", "evidence_attempt_invariant", "v2_compare_semantic_preservation", "session_log_root_cause_and_campaign_heartbeat", "v2_entry_validation_session_carry_forward", "llm_evidence_environment_fail_safe", "mandatory_rules", "supersedes", "projection_state", "authority"
  ],
  "properties": {
    "projection_schema_version": {"type": "string", "const": "1.0"},
    "contract_id": {"type": "string", "const": "LF-RI5-DEVELOPMENT-GATES"},
    "contract_name": {"type": "string", "const": "RI#5 Development and Candidate Release Gates"},
    "source_internal_commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$", "x-lf-content-class": "machine-identity"},
    "applies_to": {
      "type": "array",
      "items": {"type": "string", "enum": ["RI5_IMPLEMENTATION", "RI5_VERIFICATION", "RI5_CANDIDATE_RELEASE", "RI5_HUMAN_RUNTIME_VERIFICATION", "SYNCHRONIZATION_CLOSURE"]}
    },
    "source_contracts": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "release_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_accepted_final", "current_ri4_identity", "anti_regression_ledger", "release_entries", "release_flow"],
      "properties": {
        "last_accepted_final": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "filename", "sha256"],
          "properties": {
            "version": {"type": "string", "const": "0.47"},
            "filename": {"type": "string", "const": "LF-RI5-v0.47-EvidenceTimezoneDependency-Hotfix-FINAL.zip"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "x-lf-content-class": "machine-identity"}
          }
        },
        "current_ri4_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "state_contract", "source_package", "source_package_sha256", "acceptance"],
          "properties": {
            "version": {"type": "string", "const": "0.71"},
            "state_contract": {"type": "string", "const": "RI4_FC_STATE_V047"},
            "source_package": {"type": "string", "const": "EMBEDDED_RI4_v0.71_SEMANTIC_QUALITY_HARDENING"},
            "source_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "x-lf-content-class": "machine-identity"},
            "acceptance": {"type": "string", "const": "CURRENT_CANDIDATE_MACHINE_VERIFIED_HUMAN_RUNTIME_PENDING"}
          }
        },
        "anti_regression_ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "path", "sha256", "knowledge_basis", "policy"],
          "properties": {
            "identity": {"type": "string", "const": "LF_RI5_ANTI_REGRESSION_FIXTURES_V1.0"},
            "path": {"type": "string", "const": "contracts/ANTI-REGRESSION-FIXTURES-v1.0.json"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "x-lf-content-class": "machine-identity"},
            "knowledge_basis": {"type": "string", "const": "contracts/ANTI-REGRESSION-FIXTURES-v0.63.json"},
            "policy": {"type": "string", "const": "MONOTONIC_PROTECTION_NO_WEAKENING"}
          }
        },
        "release_entries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["anti_regression_gate", "packaging"],
          "properties": {
            "anti_regression_gate": {"type": "string", "const": "tools/anti_regression_gate.py"},
            "packaging": {"type": "string", "const": "tools/build_final.py"}
          }
        },
        "release_flow": {
          "type": "array",
          "items": {"type": "string", "enum": ["CANONICAL_LAST_ACCEPTED_BASELINE", "CURRENT_ANTI_REGRESSION_LEDGER", "ANTI_REGRESSION_GATE", "CANONICAL_PACKAGING", "FINAL"]},
          "minItems": 5,
          "maxItems": 5
        }
      }
    },
    "evidence_attempt_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "contract_id", "terminal_order", "runtime_run_separation", "persistence_failure_exit_code", "historical_104321", "cp932_console_regression", "v2_entry_cli_binding", "v2_entry_canonical_output", "human_runtime", "production_binding"],
      "properties": {
        "status": {"type": "string", "const": "CANONICAL_MACHINE_CLOSED"},
        "contract_id": {"type": "string", "const": "LF-EVIDENCE-ATTEMPT-INVARIANT"},
        "terminal_order": {
          "type": "array",
          "items": {"type": "string", "enum": ["EVIDENCE_SESSION_START", "GATE_OR_RUNTIME", "PASS_FAIL_OR_EXCEPTION", "EVIDENCE_ZIP_FINALIZE", "LF_EKB_PERSIST", "EKB_RECEIPT_READ_BACK_VERIFY", "TERMINAL"]},
          "minItems": 7,
          "maxItems": 7
        },
        "runtime_run_separation": {"type": "string", "const": "VALIDATION_SESSION_DOES_NOT_COUNT_AS_RUNTIME_RUN"},
        "persistence_failure_exit_code": {"type": "string", "const": "74"},
        "historical_104321": {"type": "string", "const": "HISTORICAL_IMMUTABLE_EVIDENCE_LOST_NOT_CANONICALLY_INGESTIBLE"},
        "cp932_console_regression": {"type": "string", "const": "MACHINE_CLOSED"},
        "v2_entry_cli_binding": {"type": "string", "const": "FIXED_OUTPUT_NO_CALLER_OUT_ARGUMENT"},
        "v2_entry_canonical_output": {"type": "string", "const": "verification/V2-ENTRY-E2E-RESULT.json"},
        "human_runtime": {"type": "string", "const": "PENDING_NOT_EXECUTED"},
        "production_binding": {"type": "string", "const": "UNCHANGED"}
      }
    },
    "v2_compare_semantic_preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "operation", "comparison_axis", "decision_context", "entity_type", "minimum_comparison_members", "generic_deployment_category_comparison", "human_runtime", "production_binding"],
      "properties": {
        "status": {"type": "string", "const": "CANONICAL_MACHINE_CLOSED"},
        "operation": {"type": "string", "const": "COMPARE"},
        "comparison_axis": {"type": "string", "const": "USE_CASE"},
        "decision_context": {"type": "string", "const": "LOCAL_AI_ENVIRONMENT_USAGE"},
        "entity_type": {"type": "string", "const": "MODEL"},
        "minimum_comparison_members": {"type": "integer", "minimum": 2},
        "generic_deployment_category_comparison": {"type": "string", "const": "INSUFFICIENT"},
        "human_runtime": {"type": "string", "const": "NOT_EXECUTED"},
        "production_binding": {"type": "string", "const": "UNCHANGED"}
      }
    },
    "session_log_root_cause_and_campaign_heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "run_diagnostic_summary", "failure_diagnostic", "known_pre_artifact_failure_classification", "operational_diagnostics_export", "failure_artifact_ui_fallback", "campaign_heartbeat", "terminal_hold_semantics", "human_runtime", "production_binding"],
      "properties": {
        "status": {"type": "string", "const": "CANONICAL_MACHINE_CLOSED"},
        "run_diagnostic_summary": {"type": "string", "const": "REQUIRED_FOR_EVERY_COMPLETED_RUN"},
        "failure_diagnostic": {"type": "string", "const": "REQUIRED_FOR_FAIL_OR_FATAL"},
        "known_pre_artifact_failure_classification": {"type": "string", "const": "RI5_TERMINAL_EVIDENCE"},
        "operational_diagnostics_export": {"type": "string", "const": "REQUIRED_WITH_EXACT_OBSERVED_VALUES"},
        "failure_artifact_ui_fallback": {"type": "string", "const": "RI5_FAILURE_DIAGNOSTIC"},
        "campaign_heartbeat": {"type": "string", "const": "INDEPENDENT_PUMP_WHILE_WORKER_ALIVE"},
        "terminal_hold_semantics": {"type": "string", "const": "UNCHANGED"},
        "human_runtime": {"type": "string", "const": "NOT_EXECUTED"},
        "production_binding": {"type": "string", "const": "UNCHANGED"}
      }
    },
    "v2_entry_validation_session_carry_forward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "session_identity_prefix", "runtime_campaign_prefix", "counts_as_runtime_run", "persistence", "human_runtime", "production_binding"],
      "properties": {
        "status": {"type": "string", "const": "CANONICAL_MACHINE_CLOSED"},
        "session_identity_prefix": {"type": "string", "const": "VAL-V2E2E-"},
        "runtime_campaign_prefix": {"type": "string", "const": "PROHIBITED"},
        "counts_as_runtime_run": {"type": "boolean", "const": false},
        "persistence": {"type": "string", "const": "VALIDATION_ONLY_EKB_RECEIPT_READ_BACK"},
        "human_runtime": {"type": "string", "const": "NOT_EXECUTED"},
        "production_binding": {"type": "string", "const": "UNCHANGED"}
      }
    },
    "llm_evidence_environment_fail_safe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "environment_hard_deadline", "timeout_behavior", "console_start_visibility", "child_process_launchability", "human_runtime", "production_binding"],
      "properties": {
        "status": {"type": "string", "const": "CANONICAL_MACHINE_CLOSED"},
        "environment_hard_deadline": {"type": "string", "const": "REQUIRED_BEFORE_AND_AFTER_CHILD"},
        "timeout_behavior": {"type": "string", "const": "DIAGNOSTIC_EVIDENCE_AND_CONTINUE"},
        "console_start_visibility": {"type": "string", "const": "IMMEDIATE"},
        "child_process_launchability": {"type": "string", "const": "REGRESSION_PROTECTED"},
        "human_runtime": {"type": "string", "const": "NOT_EXECUTED"},
        "production_binding": {"type": "string", "const": "UNCHANGED"}
      }
    },
    "mandatory_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "severity", "requirement"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^RI5-[A-Z-]+-[0-9]{3}$"},
          "severity": {"type": "string", "const": "BLOCKING"},
          "requirement": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "supersedes": {"type": ["string", "null"], "maxLength": 128},
    "projection_state": {"type": "string", "enum": ["FORMAL_LAST_SYNCHRONIZED_CURRENT", "PUBLIC_RECOVERY_PENDING"]},
    "authority": {"type": "string", "const": "INTERNAL CANONICAL / PUBLIC READ-ONLY PROJECTION"}
  }
}
